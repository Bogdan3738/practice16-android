<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:background="#FFFFFF" xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:text="@string/users_title" android:textSize="28sp" android:textStyle="bold" android:textColor="@color/black" />
        <ListView android:id="@+id/listView" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="0dp" />
    </LinearLayout>
    <include layout="@layout/profile_panel" />
</FrameLayout>
